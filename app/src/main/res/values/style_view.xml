<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="View" />

    <style name="View.Recycler">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:overScrollMode">never</item>
    </style>

    <style name="View.Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/height_divider</item>
        <item name="android:background">@color/divider</item>
    </style>

    <style name="View.Dialog" />

    <style name="View.Dialog.Label">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/TextAppearance.Dialog.Label</item>
    </style>
</resources>