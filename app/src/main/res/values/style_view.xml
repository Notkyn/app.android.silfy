<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="View" />

    <style name="View.Recycler">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:overScrollMode">never</item>
    </style>

    <style name="View.Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/height_divider</item>
        <item name="android:background">@color/divider</item>
    </style>

    <style name="View.Dialog" />

    <style name="View.Dialog.Label">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/TextAppearance.Dialog.Label</item>
    </style>

    <style name="View.ArrowBack">
        <item name="android:layout_width">42dp</item>
        <item name="android:layout_height">20dp</item>
        <item name="srcCompat">@drawable/ic_arrow_back</item>
    </style>

    <style name="View.Text" />

    <style name="View.Text.Header">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:layout_marginStart">45dp</item>
        <item name="android:layout_marginEnd">45dp</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textAppearance">@style/TextAppearance.Title.Header</item>
    </style>

    <style name="View.Text.Header.Small">
        <item name="android:textAppearance">@style/TextAppearance.Title.Header.Small</item>
    </style>

    <style name="View.IconButton">
        <item name="android:layout_width">@dimen/height_icon_button</item>
        <item name="android:layout_height">@dimen/height_icon_button</item>
        <item name="android:layout_marginEnd">15dp</item>
        <item name="android:padding">@dimen/padding_icon_button</item>
        <item name="android:foreground">@drawable/selector_bg_ripple</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>