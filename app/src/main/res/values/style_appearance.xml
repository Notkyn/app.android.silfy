<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/roboto</item>
        <item name="fontFamily">@font/roboto</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">@dimen/text</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColorHint">@color/hint</item>
    </style>

    <style name="TextAppearance.InputLabel">
        <item name="android:textSize">@dimen/text_label_input</item>
    </style>

    <style name="TextAppearance.Button">
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:textColor">@color/text_button</item>
    </style>

    <style name="TextAppearance.Button.Small">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Button.Go">
        <item name="android:textSize">@dimen/text_button_go</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Tab">
        <item name="android:textSize">@dimen/text_tab</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Title"/>

    <style name="TextAppearance.Title.Header">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Text"/>

    <style name="TextAppearance.Text.WordState">
        <item name="android:textSize">@dimen/text_word_state</item>
    </style>
</resources>