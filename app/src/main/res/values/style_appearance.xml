<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/roboto</item>
        <item name="fontFamily">@font/roboto</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">@dimen/text</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColorHint">@color/hint</item>
    </style>

    <style name="TextAppearance.InputLabel">
        <item name="android:textSize">@dimen/text_label_input</item>
    </style>

    <style name="TextAppearance.Button">
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:textColor">@color/text_button</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Button.MenuItem">
        <item name="android:textSize">@dimen/text_button_menu_item</item>
        <item name="android:textColor">@color/primary_dark_color</item>
    </style>

    <style name="TextAppearance.Button.Revers">
        <item name="android:textColor">@color/primary_dark_color</item>
    </style>

    <style name="TextAppearance.Button.Go">
        <item name="android:textSize">@dimen/text_button_go</item>
    </style>

    <style name="TextAppearance.Button.Menu">
        <item name="android:textSize">@dimen/text_button_menu</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <style name="TextAppearance.Button.Answer">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.Tab">
        <item name="android:textSize">@dimen/text_tab</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Title"/>

    <style name="TextAppearance.Title.Header">
        <item name="android:textColor">@color/secondary_color</item>
        <item name="android:textSize">@dimen/text_header</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Title.Header.Small">
        <item name="android:textSize">@dimen/text_header_small</item>
    </style>

    <style name="TextAppearance.Text"/>

    <style name="TextAppearance.Text.Label">
        <item name="android:textSize">@dimen/text_label</item>
    </style>

    <style name="TextAppearance.Text.Label.Revers">
        <item name="android:textColor">@color/secondary_color</item>
    </style>

    <style name="TextAppearance.Text.Label.Bold">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Text.Sub">
        <item name="android:textSize">@dimen/text_sub</item>
        <item name="android:textColor">@color/text_sub</item>
    </style>

    <style name="TextAppearance.Text.Sub.Dark">
        <item name="android:textColor">@color/text</item>
    </style>

    <style name="TextAppearance.Text.WordState">
        <item name="android:textSize">@dimen/text_word_state</item>
    </style>

    <style name="TextAppearance.Text.SubLabel">
        <item name="android:textSize">@dimen/text_sub_label</item>
        <item name="android:textColor">@color/text_sub_label</item>
    </style>

    <style name="TextAppearance.Text.SubLabel.Bold">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Text.SubLabel.Empty">
        <item name="android:textSize">@dimen/text</item>
        <item name="android:textColor">@color/text_sub_label</item>
    </style>

    <style name="TextAppearance.Dialog"/>

    <style name="TextAppearance.Dialog.Label">
        <item name="android:textSize">@dimen/text_dialog_label</item>
    </style>

    <style name="TextAppearance.Dialog.Title">
        <item name="android:textSize">@dimen/text_dialog_title</item>
    </style>

    <style name="TextAppearance.DictionaryCard">
        <item name="textFillColor">@color/text</item>
        <item name="android:textSize">@dimen/text_dictionary_card</item>
    </style>

    <style name="TextAppearance.DictionaryCard.Content">
        <item name="android:textSize">@dimen/text_dictionary_card_content</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.RadioBtn">
        <item name="android:textSize">@dimen/text_radio_btn</item>
        <item name="android:textColor">@color/radio_button</item>
    </style>
</resources>