<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Silfy" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primary_color</item>
        <item name="colorPrimaryDark">@color/primary_dark_color</item>
        <item name="colorAccent">@color/accent_color</item>
        <!-- Background color -->
        <item name="android:windowBackground">@color/primary_color</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/primary_dark_color</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/primary_dark_color</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <!-- Prevent multitouch-->
        <item name="android:windowEnableSplitTouch">false</item>
        <item name="android:splitMotionEvents">false</item>
        <!-- Prevent breaking words -->
        <item name="android:breakStrategy">simple</item>
        <!--   Toolbar    -->
        <item name="android:actionOverflowButtonStyle">@style/Theme.Silfy.ActionButtonOverflow</item>
        <item name="android:actionMenuTextAppearance">@style/TextAppearance.MenuTextStyle</item>
        <item name="android:actionMenuTextColor">@color/text</item>
        <!--   Popup Menu    -->
        <item name="android:popupMenuStyle">@style/Theme.Silfy.PopupMenuStyle</item>
        <item name="popupMenuStyle">@style/Theme.Silfy.PopupMenuStyle</item>
        <item name="textAppearanceLargePopupMenu">@style/myPopupMenuTextAppearanceLarge</item>
        <item name="android:textAppearanceLargePopupMenu">@style/myPopupMenuTextAppearanceLarge</item>
        <item name="textAppearanceSmallPopupMenu">@style/myPopupMenuTextAppearanceSmall</item>
        <item name="android:textAppearanceSmallPopupMenu">@style/myPopupMenuTextAppearanceSmall</item>
    </style>

    <style name="Root">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
    </style>

    <style name="Root.Header">
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@color/bg_header</item>
    </style>

    <style name="Root.Header.Big">
        <item name="android:layout_height">80dp</item>
    </style>

    <style name="Root.Content">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@color/transparent</item>
    </style>

    <style name="Root.Scroll">
        <item name="android:layout_height">0dp</item>
        <item name="android:overScrollMode">never</item>
    </style>

    <style name="Root.Dialog">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_bottomsheet</item>
        <item name="android:paddingEnd">@dimen/padding_dialog_horizontal</item>
        <item name="android:paddingStart">@dimen/padding_dialog_horizontal</item>
        <item name="android:paddingTop">@dimen/padding_dialog_top</item>
        <item name="android:paddingBottom">@dimen/padding_dialog_bottom</item>
    </style>

    <style name="CustomAlertDialogTheme" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="materialAlertDialogTitleTextStyle">@style/AlertTitleStyle</item>
        <item name="shapeAppearanceMediumComponent">@style/RoundShapeAppearance</item>
        <item name="android:background">@color/primary_color</item>
        <item name="buttonBarPositiveButtonStyle">@style/Alert.Button.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/Alert.Button.Negative</item>
    </style>

    <style name="RoundShapeAppearance" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="AlertTitleStyle" parent="@style/MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:maxLines">5</item>
        <item name="android:singleLine">false</item>
    </style>

    <style name="Alert.Button.Positive" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="rippleColor">@color/bg_ripple</item>
        <item name="android:textColor">@color/primary_dark_color</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Alert.Button.Negative" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="rippleColor">@color/bg_ripple</item>
        <item name="android:textColor">@color/grey</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!--   Toolbar    -->
    <style name="Theme.Silfy.ActionButtonOverflow" parent="@style/Widget.AppCompat.ActionButton.Overflow">
        <item name="android:tint">@color/secondary_color</item>
    </style>

    <style name="Theme.Silfy.AppBarOverlay" parent="ThemeOverlay.MaterialComponents.ActionBar">
        <item name="titleCentered">true</item>
        <item name="android:background">@color/primary_dark_color</item>
        <item name="titleTextColor">@color/secondary_color</item>
        <item name="titleTextAppearance">@style/TextAppearance.ActionBar</item>
    </style>

    <style name="TextAppearance.ActionBar" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textSize">24sp</item>
    </style>

    <style name="TextAppearance.MenuTextStyle" parent="android:TextAppearance.Holo.Widget.ActionBar.Menu">
        <item name="android:textColor">@color/text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!--  Popup Menu  -->
    <style name="Theme.Silfy.PopupMenuStyle" parent="@style/Widget.AppCompat.Light.PopupMenu"/>

    <style name="myPopupMenuTextAppearanceSmall" parent="@style/TextAppearance.AppCompat.Light.Widget.PopupMenu.Small">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="myPopupMenuTextAppearanceLarge" parent="@style/TextAppearance.AppCompat.Light.Widget.PopupMenu.Large">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>