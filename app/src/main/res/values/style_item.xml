<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Item"/>

    <style name="Item.Sort">
        <item name="android:layout_width">@dimen/height_sort_icon</item>
        <item name="android:layout_height">@dimen/height_sort_icon</item>
        <item name="android:layout_gravity">center_vertical</item>
        <item name="android:layout_marginTop">@dimen/margin_sort_vertical</item>
        <item name="android:layout_marginBottom">@dimen/margin_sort_vertical</item>
        <item name="android:layout_marginStart">@dimen/margin_sort_horizontal</item>
        <item name="android:layout_marginEnd">@dimen/margin_sort_horizontal</item>
    </style>

    <style name="Item.WordState">
        <item name="android:layout_width">@dimen/height_item_word_state</item>
        <item name="android:layout_height">@dimen/height_item_word_state</item>
    </style>

    <style name="Item.Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/height_divider</item>
        <item name="android:background">@color/divider</item>
        <item name="android:layout_marginStart">@dimen/margin_horizontal_text_input_layout</item>
        <item name="android:layout_marginEnd">@dimen/margin_horizontal_text_input_layout</item>
    </style>

    <style name="Item.Input">
        <item name="android:layout_marginStart">@dimen/margin_horizontal_text_input_layout</item>
        <item name="android:layout_marginEnd">@dimen/margin_horizontal_text_input_layout</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="Item.Input.Label">
        <item name="android:textAppearance">@style/TextAppearance</item>
    </style>

    <style name="Item.Input.SubLabel">
        <item name="android:layout_marginTop">5dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Text.SubLabel</item>
    </style>
</resources>