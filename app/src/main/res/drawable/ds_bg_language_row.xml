<?xml version="1.0" encoding="utf-8"?>
<!--  List row: aqua-row when selected (activated), light press feedback  -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/aqua_row" android:state_activated="true" />
    <item android:drawable="@color/row_pressed" android:state_pressed="true" />
    <item android:drawable="@android:color/transparent" />
</selector>
