<?xml version="1.0" encoding="utf-8"?>
<!--  5c "New profile" row: 1.5dp dashed border, radius 18, ripple inside  -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ds_ripple_ink">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@android:color/white" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="@dimen/ds_stroke_dashed"
                android:color="@color/dashed_border"
                android:dashWidth="@dimen/ds_dash_width"
                android:dashGap="@dimen/ds_dash_gap" />
        </shape>
    </item>
</ripple>
