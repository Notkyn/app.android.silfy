<?xml version="1.0" encoding="utf-8"?>
<!--  Switch thumb: 22dp circle inset 3dp from the track top/bottom  -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:bottom="3dp"
        android:left="2dp"
        android:right="2dp"
        android:top="3dp">
        <shape android:shape="oval">
            <size
                android:width="@dimen/ds_switch_thumb"
                android:height="@dimen/ds_switch_thumb" />
            <solid android:color="@android:color/white" />
        </shape>
    </item>
</layer-list>
