<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="viewModel"
            type="ua.notky.silfy.viewmodel.splash.SplashViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        style="@style/Root">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/text_app_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="35dp"
            android:layout_marginEnd="20dp"
            android:textColor="@color/text_accent_color"
            android:textSize="@dimen/text_app_version"
            android:text="@{viewModel.version}"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintVertical_bias="0"
            tools:text="v 1.0.0"/>

        <ProgressBar
            style="@style/View.ProgressBar"
            android:visibility="visible"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/app_logo_image"
            app:layout_constraintBottom_toTopOf="@id/app_logo_describe"/>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/app_logo_describe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="60dp"
            android:layout_marginHorizontal="@dimen/margin_small_horizontal_text"
            android:textAlignment="center"
            android:textColor="@color/accent_color"
            android:textSize="@dimen/text_app_description"
            android:text="@string/text_app_description"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintVertical_bias="1"/>

        <ImageView
            android:id="@+id/app_logo_image"
            android:layout_width="300dp"
            android:layout_height="190dp"
            android:src="@drawable/ic_app_logo"
            android:contentDescription="@string/image_app_logo"
            android:layout_marginTop="200dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintVertical_bias="0"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>