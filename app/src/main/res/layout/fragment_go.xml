<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".ui.fragment.go.GoFragment">

    <data>
        <variable
            name="model"
            type="ua.notky.silfy.models.observable.GoModel" />

        <variable
            name="answerWriteModel"
            type="ua.notky.silfy.models.observable.answer.WordAnswerWriteModel" />

        <variable
            name="answerSymbolModel"
            type="ua.notky.silfy.models.observable.answer.WordAnswerSymbolModel" />

        <variable
            name="state"
            type="ua.notky.silfy.models.observable.StateModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ua.notky.silfy.ui.layout.go.GoHeaderLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:setModel="@{model}"/>

        <androidx.core.widget.NestedScrollView
            style="@style/Root.Scroll"
            android:layout_height="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/header"
            app:layout_constraintBottom_toTopOf="@id/footer">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/text_checked_word"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginHorizontal="30dp"
                    android:padding="30dp"
                    android:textAlignment="center"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="@color/text"
                    android:background="@drawable/bg_go_text"
                    android:elevation="4dp"
                    android:text="@{model.word.en}"
                    app:setActualWord="@{model.word}"
                    app:setLangType="@{model.actualLangType}"
                    tools:text="Apple" />

                <View
                    android:id="@+id/divider_top"
                    style="@style/View.Divider"
                    android:layout_marginTop="20dp"
                    android:layout_marginHorizontal="@dimen/padding_small_horizontal"/>

                <ua.notky.silfy.ui.layout.go.GoSelectAnswerLayout
                    android:id="@+id/answer_select_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:onSelectGoMode="@{model.goMode}"/>

                <ua.notky.silfy.ui.layout.go.GoWriteAnswerLayout
                    android:id="@+id/answer_write_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:setModel="@{answerWriteModel}"
                    app:onWriteGoMode="@{model.goMode}"/>

                <ua.notky.silfy.ui.layout.go.GoSymbolAnswerLayout
                    android:id="@+id/answer_symbol_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:setModel="@{answerSymbolModel}"
                    app:onSymbolGoMode="@{model.goMode}"/>

            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.core.widget.NestedScrollView>

        <ua.notky.silfy.ui.layout.go.GoFooterLayout
            android:id="@+id/footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/padding_small_horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:setModel="@{model}"/>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg_overlay"
            android:visibility="gone"
            app:gone="@{state.isLoading}"
            tools:visibility="visible">

            <ProgressBar
                style="@style/View.ProgressBar"
                android:layout_gravity="center"
                android:visibility="visible" />
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>