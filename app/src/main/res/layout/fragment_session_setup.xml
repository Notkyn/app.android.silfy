<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".ui.fragment.go.SessionSetupFragment">

    <!--  4a New session / 6b Training mode: settings cards, "{n} words match", Start / Save settings  -->
    <LinearLayout
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/screen_bg"
        android:orientation="vertical">

        <!--  Toolbar: ✕ (session) or ← (menu)  -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/ds_toolbar_height"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_back"
                style="@style/Widget.Silfy.Button.Icon.Toolbar"
                android:contentDescription="@string/action_back"
                app:icon="@drawable/ic_lc_x" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/text_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Silfy.Title.Toolbar"
                tools:text="@string/setup_title_start" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="@dimen/ds_screen_padding"
            android:paddingTop="4dp"
            android:paddingEnd="@dimen/ds_screen_padding"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!--  Difficulty  -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Silfy.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/ds_card_padding">

                        <androidx.appcompat.widget.AppCompatTextView
                            style="@style/Widget.Silfy.Text.CardTitle"
                            android:text="@string/setup_difficulty"
                            app:drawableStartCompat="@drawable/ic_lc_gauge_18" />

                        <ua.notky.silfy.ui.view.segmented.SegmentedControl
                            android:id="@+id/segmented_difficulty"
                            style="@style/Widget.Silfy.Segmented"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/text_difficulty_note"
                            style="@style/Widget.Silfy.Text.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            tools:text="@string/setup_easy_note" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!--  Duration  -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Silfy.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_card_gap">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/ds_card_padding">

                        <androidx.appcompat.widget.AppCompatTextView
                            style="@style/Widget.Silfy.Text.CardTitle"
                            android:text="@string/setup_duration"
                            app:drawableStartCompat="@drawable/ic_lc_timer_18" />

                        <ua.notky.silfy.ui.view.segmented.SegmentedControl
                            android:id="@+id/segmented_duration"
                            style="@style/Widget.Silfy.Segmented"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!--  Limit mistakes  -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Silfy.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_card_gap">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/ds_card_padding">

                        <LinearLayout
                            android:id="@+id/row_mistake_limit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <androidx.appcompat.widget.AppCompatTextView
                                style="@style/Widget.Silfy.Text.CardTitle"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:text="@string/setup_limit_mistakes"
                                app:drawableStartCompat="@drawable/ic_lc_heart_crack_18" />

                            <com.google.android.material.switchmaterial.SwitchMaterial
                                android:id="@+id/switch_mistake_limit"
                                style="@style/Widget.Silfy.Switch"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:clickable="false"
                                android:focusable="false"
                                android:importantForAccessibility="no" />
                        </LinearLayout>

                        <ua.notky.silfy.ui.view.segmented.SegmentedControl
                            android:id="@+id/segmented_mistakes"
                            style="@style/Widget.Silfy.Segmented"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!--  Words  -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Silfy.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_card_gap">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/ds_card_padding">

                        <androidx.appcompat.widget.AppCompatTextView
                            style="@style/Widget.Silfy.Text.CardTitle"
                            android:text="@string/setup_words"
                            app:drawableStartCompat="@drawable/ic_lc_book_open_18" />

                        <ua.notky.silfy.ui.view.segmented.SegmentedControl
                            android:id="@+id/segmented_words"
                            style="@style/Widget.Silfy.Segmented"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp" />

                        <LinearLayout
                            android:id="@+id/row_blacklist"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="12dp"
                                android:layout_weight="1"
                                android:includeFontPadding="false"
                                android:text="@string/setup_include_blacklist"
                                android:textAppearance="@style/TextAppearance.Silfy.Caption.Medium"
                                android:textColor="@color/text_secondary"
                                android:textSize="14sp" />

                            <com.google.android.material.switchmaterial.SwitchMaterial
                                android:id="@+id/switch_blacklist"
                                style="@style/Widget.Silfy.Switch"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:clickable="false"
                                android:focusable="false"
                                android:importantForAccessibility="no" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!--  Categories: none selected — all words  -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_categories"
                    style="@style/Widget.Silfy.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_card_gap">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/ds_card_padding">

                        <androidx.appcompat.widget.AppCompatTextView
                            style="@style/Widget.Silfy.Text.CardTitle"
                            android:text="@string/categories_title"
                            app:drawableStartCompat="@drawable/ic_lc_layout_grid_18" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chips_categories"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            app:chipSpacingHorizontal="8dp"
                            app:chipSpacingVertical="8dp" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:includeFontPadding="false"
                            android:text="@string/setup_categories_note"
                            android:textAppearance="@style/TextAppearance.Silfy.Caption.Small" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!--  "{n} words match these settings" + Start / Save settings  -->
        <LinearLayout
            android:id="@+id/bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/ds_screen_padding"
            android:paddingTop="@dimen/ds_bottom_bar_padding_top"
            android:paddingEnd="@dimen/ds_screen_padding"
            android:paddingBottom="@dimen/ds_bottom_bar_padding_bottom">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/text_match"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textAppearance="@style/TextAppearance.Silfy.Caption.Medium"
                android:textColor="@color/text_secondary"
                tools:text="28 words match these settings" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_main"
                style="@style/Widget.Silfy.Button.Accent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:icon="@drawable/ic_lc_play"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconSize="@dimen/ds_icon_small"
                tools:text="@string/setup_start" />
        </LinearLayout>
    </LinearLayout>
</layout>
