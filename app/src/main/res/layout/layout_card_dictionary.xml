<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".ui.layout.menu.DictionaryCardLayout">

    <data>
        <variable
            name="type"
            type="ua.notky.silfy.models.enums.DictionaryCardType" />

        <variable
            name="content"
            type="int" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="20dp"
        android:elevation="2dp"
        android:background="@drawable/bg_dictionary_card">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:textAppearance="@style/TextAppearance.DictionaryCard"
            app:card_title="@{type}"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/button_settings"
            tools:text="Кількість слів"/>

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/button_settings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="4dp"
            android:background="@drawable/selector_bg_ripple"
            android:src="@drawable/ic_settings"
            app:gone="@{content > 0}"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <View
            android:id="@+id/divider"
            style="@style/View.Divider"
            android:layout_marginTop="2dp"
            android:layout_width="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="@id/title"
            app:layout_constraintTop_toBottomOf="@id/title"/>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/image_list_type"
            android:layout_width="35dp"
            android:layout_height="35dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/counter"
            app:layout_constraintBottom_toBottomOf="@id/counter"
            app:card_list_type="@{type}"
            tools:src="@drawable/ic_blacklist_checked"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/counter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginHorizontal="10dp"
            android:textAlignment="center"
            android:text="@{String.valueOf(content)}"
            android:textAppearance="@style/TextAppearance.DictionaryCard.Content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider"
            tools:text="35624"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/button_action"
            style="@style/Button.DictionaryCard"
            android:layout_marginTop="20dp"
            app:card_enabled="@{content}"
            app:card_action="@{type}"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:text="Очистити список"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>