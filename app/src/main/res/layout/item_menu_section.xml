<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <!--  6a Menu section row (64dp): icon tile 40 (tint — MenuFragment), title, subtitle, chevron  -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ds_card_padding"
        android:paddingEnd="@dimen/ds_card_padding">

        <FrameLayout
            android:id="@+id/icon_tile"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/ds_bg_row_icon">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/icon"
                android:layout_width="@dimen/ds_icon_small"
                android:layout_height="@dimen/ds_icon_small"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                app:tint="@color/ink"
                tools:srcCompat="@drawable/ic_lc_target" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/text_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Silfy.RowTitle"
                tools:text="Training mode" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/text_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Silfy.Caption"
                android:textSize="12sp"
                tools:text="Difficulty, duration, word lists" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/ic_lc_chevron_right"
            app:tint="@color/text_placeholder" />
    </LinearLayout>
</layout>
