<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".ui.fragment.info.StateLevelInfoFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="20dp">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/title_1"
                style="@style/View.InfoTitle"
                android:text="@string/text_info_level_knowledge_1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <View
                android:id="@+id/point_1"
                style="@style/View.Point"
                app:layout_constraintTop_toTopOf="@id/title_1"
                app:layout_constraintEnd_toStartOf="@id/title_1"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/title_2"
                style="@style/View.InfoTitle"
                android:text="@string/text_info_level_knowledge_2"
                android:layout_marginTop="15dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/title_1"/>

            <View
                android:id="@+id/point_2"
                style="@style/View.Point"
                app:layout_constraintTop_toTopOf="@id/title_2"
                app:layout_constraintEnd_toStartOf="@id/title_2"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/title_3"
                style="@style/View.InfoTitle"
                android:text="@string/text_info_level_knowledge_3"
                android:layout_marginTop="15dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/title_2"/>

            <View
                android:id="@+id/point_3"
                style="@style/View.Point"
                app:layout_constraintTop_toTopOf="@id/title_3"
                app:layout_constraintEnd_toStartOf="@id/title_3"/>

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/state_excellent"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginTop="15dp"
                android:layout_marginStart="10dp"
                android:src="@drawable/ic_word_state_excellent"
                app:layout_constraintStart_toStartOf="@id/title_3"
                app:layout_constraintTop_toBottomOf="@id/title_3"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/text_info_excellent_level"
                android:textSize="12sp"
                android:textColor="@color/text"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="20dp"
                app:layout_constraintStart_toEndOf="@id/state_excellent"
                app:layout_constraintTop_toTopOf="@id/state_excellent"
                app:layout_constraintBottom_toBottomOf="@id/state_excellent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/state_good"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginTop="5dp"
                android:layout_marginStart="10dp"
                android:src="@drawable/ic_word_state_good"
                app:layout_constraintStart_toStartOf="@id/title_3"
                app:layout_constraintTop_toBottomOf="@id/state_excellent"/>

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/state_average"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginTop="5dp"
                android:layout_marginStart="10dp"
                android:src="@drawable/ic_word_state_average"
                app:layout_constraintStart_toStartOf="@id/title_3"
                app:layout_constraintTop_toBottomOf="@id/state_good"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/text_info_average_level"
                android:textSize="12sp"
                android:textColor="@color/text"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="20dp"
                app:layout_constraintStart_toEndOf="@id/state_average"
                app:layout_constraintTop_toTopOf="@id/state_average"
                app:layout_constraintBottom_toBottomOf="@id/state_average"
                app:layout_constraintEnd_toEndOf="parent"/>

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/state_poor"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginTop="5dp"
                android:layout_marginStart="10dp"
                android:src="@drawable/ic_word_state_poor"
                app:layout_constraintStart_toStartOf="@id/title_3"
                app:layout_constraintTop_toBottomOf="@id/state_average"/>

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/state_unknown"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginTop="5dp"
                android:layout_marginStart="10dp"
                android:src="@drawable/ic_word_state_unknown"
                app:layout_constraintStart_toStartOf="@id/title_3"
                app:layout_constraintTop_toBottomOf="@id/state_poor"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/text_info_unknown_level"
                android:textSize="12sp"
                android:textColor="@color/text"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="20dp"
                app:layout_constraintStart_toEndOf="@id/state_unknown"
                app:layout_constraintTop_toTopOf="@id/state_unknown"
                app:layout_constraintBottom_toBottomOf="@id/state_unknown"
                app:layout_constraintEnd_toEndOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</layout>