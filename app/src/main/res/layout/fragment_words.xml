<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".ui.fragment.words.WordsFragment">

    <!--  2a/2b Dictionary: header, search + sort, tabs, list card above the floating navigation  -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/screen_bg"
        android:paddingStart="@dimen/ds_screen_padding"
        android:paddingTop="10dp"
        android:paddingEnd="@dimen/ds_screen_padding">

        <!--  Header  -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/text_greeting"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="12dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Silfy.Overline"
            app:layout_constraintEnd_toStartOf="@id/button_add"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Hi, Olena" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/text_title"
            style="@style/Widget.Silfy.Text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/dictionary_title"
            android:textAppearance="@style/TextAppearance.Silfy.Headline"
            app:layout_constraintEnd_toEndOf="@id/text_greeting"
            app:layout_constraintStart_toStartOf="@id/text_greeting"
            app:layout_constraintTop_toBottomOf="@id/text_greeting" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_add"
            style="@style/Widget.Silfy.Button.Icon"
            android:layout_marginEnd="4dp"
            android:contentDescription="@string/dictionary_add_word"
            app:icon="@drawable/ic_lc_plus"
            app:layout_constraintBottom_toBottomOf="@id/text_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/text_greeting" />

        <!--  Search + sort  -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/input_search"
            style="@style/Widget.Silfy.TextInputLayout.Search"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="8dp"
            app:endIconMode="clear_text"
            app:layout_constraintEnd_toStartOf="@id/button_sort"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/text_title">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/dictionary_search_hint"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_sort"
            style="@style/Widget.Silfy.Button.Sort"
            android:layout_width="wrap_content"
            app:layout_constraintBottom_toBottomOf="@id/input_search"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/input_search"
            tools:text="@string/sort_a_z" />

        <!--  All / Favourites / Blacklist with counters  -->
        <ua.notky.silfy.ui.view.segmented.SegmentedControl
            android:id="@+id/tabs"
            style="@style/Widget.Silfy.Segmented.Tabs"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/input_search" />

        <!--  List card: wraps short lists, scrolls inside when longer. Bottom margin — WordsFragment (insets)  -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_words"
            style="@style/Widget.Silfy.Card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tabs"
            app:layout_constraintVertical_bias="0">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:overScrollMode="never"
                    android:scrollbars="none"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:itemCount="6"
                    tools:listitem="@layout/item_dictionary_word" />

                <!--  Empty state  -->
                <LinearLayout
                    android:id="@+id/view_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="36dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="36dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <androidx.appcompat.widget.AppCompatTextView
                        style="@style/Widget.Silfy.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/dictionary_empty_title"
                        android:textAppearance="@style/TextAppearance.Silfy.RowTitle" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/text_empty_hint"
                        style="@style/Widget.Silfy.Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:maxWidth="230dp"
                        tools:text="@string/dictionary_empty_favourites" />
                </LinearLayout>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
