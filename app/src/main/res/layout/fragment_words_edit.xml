<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".ui.fragment.words.WordsEditFragment">

    <!--  2c Edit / New word. "Save word" pinned to the bottom, above the keyboard  -->
    <LinearLayout
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/screen_bg"
        android:orientation="vertical">

        <!--  Toolbar  -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/ds_toolbar_height"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_back"
                style="@style/Widget.Silfy.Button.Icon.Toolbar"
                android:contentDescription="@string/action_back"
                app:icon="@drawable/ic_lc_arrow_left" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/text_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Silfy.Title.Toolbar"
                tools:text="@string/word_title_edit" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_delete"
                style="@style/Widget.Silfy.Button.Icon.Toolbar.Destructive"
                android:contentDescription="@string/word_delete"
                android:visibility="gone"
                app:icon="@drawable/ic_lc_trash_2"
                app:iconSize="21dp"
                tools:visibility="visible" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="@dimen/ds_form_padding"
            android:paddingTop="6dp"
            android:paddingEnd="@dimen/ds_form_padding"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!--  Word in English  -->
                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/Widget.Silfy.Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:labelFor="@id/edit_en"
                    android:text="@string/word_en_label" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/input_en"
                    style="@style/Widget.Silfy.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_label_gap">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edit_en"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/word_en_hint"
                        android:imeOptions="actionNext"
                        android:importantForAutofill="no"
                        android:inputType="textNoSuggestions"
                        android:maxLength="50"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.Silfy.RowTitle"
                        android:textSize="17sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!--  Translation + profile language badge  -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatTextView
                        style="@style/Widget.Silfy.Text.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/edit_translation"
                        android:text="@string/word_translation_label" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/text_language_badge"
                        style="@style/Widget.Silfy.Badge.Small"
                        android:layout_marginStart="6dp"
                        tools:text="UA" />
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/input_translation"
                    style="@style/Widget.Silfy.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_label_gap"
                    app:helperText="@string/word_translation_note"
                    app:helperTextEnabled="true"
                    app:helperTextTextColor="@color/text_tertiary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edit_translation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/word_translation_hint"
                        android:imeOptions="actionDone"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:maxLength="120"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <!--  Categories: chips with ✕ + dashed "Add"  -->
                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/Widget.Silfy.Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/word_categories_label" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chips_categories"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:chipSpacingHorizontal="8dp"
                    app:chipSpacingVertical="8dp">

                    <!--  Always the last child: chips are added before it  -->
                    <LinearLayout
                        android:id="@+id/button_add_category"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/ds_chip_height"
                        android:background="@drawable/ds_bg_dashed_chip"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="10dp"
                        android:paddingEnd="14dp">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:importantForAccessibility="no"
                            app:srcCompat="@drawable/ic_lc_plus"
                            app:tint="@color/ink" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:includeFontPadding="false"
                            android:text="@string/word_categories_add"
                            android:textAppearance="@style/TextAppearance.Silfy.Button.Small" />
                    </LinearLayout>
                </com.google.android.material.chip.ChipGroup>

                <!--  Favourites / Blacklist  -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Silfy.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    app:shapeAppearance="@style/ShapeAppearance.Silfy.Card.Small">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:divider="@drawable/ds_divider"
                        android:orientation="vertical"
                        android:showDividers="middle">

                        <LinearLayout
                            android:id="@+id/row_favourite"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/ds_row_height_large"
                            android:background="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp">

                            <FrameLayout
                                android:layout_width="@dimen/ds_row_icon_tile"
                                android:layout_height="@dimen/ds_row_icon_tile"
                                android:background="@drawable/ds_bg_row_icon"
                                android:backgroundTint="@color/fav_bg">

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_width="19dp"
                                    android:layout_height="19dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    app:srcCompat="@drawable/ic_lc_star"
                                    app:tint="@color/fav_icon" />
                            </FrameLayout>

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_marginEnd="12dp"
                                android:layout_weight="1"
                                android:includeFontPadding="false"
                                android:text="@string/list_favourites"
                                android:textAppearance="@style/TextAppearance.Silfy.RowTitle" />

                            <com.google.android.material.switchmaterial.SwitchMaterial
                                android:id="@+id/switch_favourite"
                                style="@style/Widget.Silfy.Switch"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:clickable="false"
                                android:focusable="false"
                                android:importantForAccessibility="no" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/row_blacklist"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/ds_row_height_large"
                            android:background="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp">

                            <FrameLayout
                                android:layout_width="@dimen/ds_row_icon_tile"
                                android:layout_height="@dimen/ds_row_icon_tile"
                                android:background="@drawable/ds_bg_row_icon"
                                android:backgroundTint="@color/seg_bg_light">

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_width="19dp"
                                    android:layout_height="19dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    app:srcCompat="@drawable/ic_lc_ban"
                                    app:tint="@color/ink" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_marginEnd="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <androidx.appcompat.widget.AppCompatTextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:includeFontPadding="false"
                                    android:text="@string/list_blacklist"
                                    android:textAppearance="@style/TextAppearance.Silfy.RowTitle" />

                                <androidx.appcompat.widget.AppCompatTextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:includeFontPadding="false"
                                    android:text="@string/word_blacklist_note"
                                    android:textAppearance="@style/TextAppearance.Silfy.Caption.Small" />
                            </LinearLayout>

                            <com.google.android.material.switchmaterial.SwitchMaterial
                                android:id="@+id/switch_blacklist"
                                style="@style/Widget.Silfy.Switch"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:clickable="false"
                                android:focusable="false"
                                android:importantForAccessibility="no" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!--  Knowledge level: existing word only. Segments — WordsEditFragment  -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_level"
                    style="@style/Widget.Silfy.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:visibility="gone"
                    app:shapeAppearance="@style/ShapeAppearance.Silfy.Card.Small"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <androidx.appcompat.widget.AppCompatTextView
                                style="@style/Widget.Silfy.Text.Label"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/word_level_label" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/button_reset_level"
                                style="@style/Widget.Silfy.Button.Link"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="-4dp"
                                android:text="@string/word_level_reset" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/level_scale"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!--  Bottom bar  -->
        <FrameLayout
            android:id="@+id/bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/ds_bottom_bar_padding_horizontal"
            android:paddingTop="@dimen/ds_bottom_bar_padding_top"
            android:paddingEnd="@dimen/ds_bottom_bar_padding_horizontal"
            android:paddingBottom="@dimen/ds_bottom_bar_padding_bottom">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_save"
                style="@style/Widget.Silfy.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:text="@string/word_save" />
        </FrameLayout>
    </LinearLayout>
</layout>
