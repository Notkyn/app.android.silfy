<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".ui.fragment.words.WordsEditFragment">

    <data>

        <variable
            name="state"
            type="ua.notky.silfy.models.observable.StateModel" />

        <variable
            name="model"
            type="ua.notky.silfy.models.observable.WordsModel" />

        <variable
            name="wordModel"
            type="ua.notky.silfy.models.observable.FormWordModel" />

        <variable
            name="translateModel"
            type="ua.notky.silfy.models.observable.FormWordModel" />

        <import type="ua.notky.silfy.models.enums.WordFormType" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout style="@style/Root">

        <ua.notky.silfy.ui.layout.word.HeaderWordEditLayout
            android:id="@+id/view_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:state="@{state}" />

        <androidx.core.widget.NestedScrollView
            style="@style/Root.Scroll"
            android:paddingBottom="115dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/view_header">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="0dp">

                <ua.notky.silfy.ui.layout.word.FormEnterWordLayout
                    android:id="@+id/form_word"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:set_model="@{wordModel}"
                    app:set_type="@{WordFormType.WORD}" />

                <ua.notky.silfy.ui.layout.word.FormEnterWordLayout
                    android:id="@+id/form_translate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/form_word"
                    app:set_model="@{translateModel}"
                    app:set_type="@{WordFormType.TRANSLATE}" />

                <ua.notky.silfy.ui.layout.category.CategoryInfoForWordLayout
                    android:id="@+id/categories"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/form_translate"/>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/button_save"
            style="@style/Button.Main"
            android:layout_marginBottom="15dp"
            android:text="@string/button_save"
            app:layout_constraintBottom_toTopOf="@id/button_word_state"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/button_word_state"
            style="@style/Item.WordState"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:src_image="@{model.state.image}"
            tools:src="@drawable/ic_word_state_unknown" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/text_word_state"
            android:layout_width="80dp"
            android:layout_height="0dp"
            android:layout_marginStart="10dp"
            android:gravity="center_vertical"
            android:text="@{model.state.title}"
            android:textAppearance="@style/TextAppearance.Text.WordState"
            app:layout_constraintBottom_toBottomOf="@+id/button_word_state"
            app:layout_constraintStart_toEndOf="@+id/button_word_state"
            app:layout_constraintTop_toTopOf="@+id/button_word_state"
            tools:text="Word State State" />

        <androidx.appcompat.widget.AppCompatCheckBox
            android:id="@+id/button_favourites"
            style="@style/Item.WordState"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="10dp"
            android:button="@drawable/selector_bg_checkbox_favourites"
            android:checked="@={model.isFavourite}"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/button_blacklist" />

        <androidx.appcompat.widget.AppCompatCheckBox
            android:id="@+id/button_blacklist"
            style="@style/Item.WordState"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="10dp"
            android:button="@drawable/selector_bg_checkbox_blacklist"
            android:checked="@={model.isBlacklist}"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>