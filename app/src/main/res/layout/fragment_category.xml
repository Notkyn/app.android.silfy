<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".ui.fragment.category.CategoryFragment">

    <!--  3a Categories: header and the 2-column grid scroll together, above the floating navigation.
          Top / bottom padding — CategoryFragment (insets)  -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/screen_bg"
        android:clipToPadding="false"
        android:paddingStart="@dimen/ds_screen_padding"
        android:paddingTop="10dp"
        android:paddingEnd="@dimen/ds_screen_padding"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!--  Header  -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/text_count"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="12dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Silfy.Overline"
                    app:layout_constraintEnd_toStartOf="@id/button_new"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="6 categories" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/text_title"
                    style="@style/Widget.Silfy.Text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/categories_title"
                    android:textAppearance="@style/TextAppearance.Silfy.Headline"
                    app:layout_constraintEnd_toEndOf="@id/text_count"
                    app:layout_constraintStart_toStartOf="@id/text_count"
                    app:layout_constraintTop_toBottomOf="@id/text_count" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_new"
                    style="@style/Widget.Silfy.Button.Icon"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="@string/categories_new"
                    app:icon="@drawable/ic_lc_folder_plus"
                    app:layout_constraintBottom_toBottomOf="@id/text_title"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/text_count" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!--  Categories + dashed "New category"  -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="2"
                tools:itemCount="7"
                tools:listitem="@layout/item_category" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</layout>
