<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".ui.dialog.category.SelectCategoryBottomsheet">

    <androidx.appcompat.widget.LinearLayoutCompat
        style="@style/Root.Dialog"
        android:orientation="vertical"
        android:paddingStart="@dimen/padding_dialog_horizontal_small"
        android:paddingEnd="@dimen/padding_dialog_horizontal_small">

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/View.Dialog.Label"
            android:layout_marginHorizontal="@dimen/padding_dialog_horizontal_small"
            android:text="@string/text_category" />

        <View
            style="@style/View.Divider"
            android:layout_marginTop="1dp"
            android:layout_marginHorizontal="@dimen/padding_dialog_horizontal_small"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view"
            style="@style/View.Recycler"
            android:layout_width="match_parent"
            android:layout_marginTop="10dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:itemCount="20"
            tools:listitem="@layout/item_select_category"
            tools:visibility="gone"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/text_empty_categories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textAlignment="center"
            android:textAppearance="@style/TextAppearance.Text.SubLabel.Empty"
            android:text="@string/text_category_empty_or_all_added"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</layout>