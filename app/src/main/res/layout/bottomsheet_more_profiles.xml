<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".ui.dialog.profile.MoreProfileBottomsheet">

    <androidx.appcompat.widget.LinearLayoutCompat
        style="@style/Root.Dialog"
        android:orientation="vertical"
        android:paddingStart="0dp"
        android:paddingEnd="0dp">

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/View.Dialog.Title"
            android:layout_width="match_parent"
            android:textAlignment="center"
            android:text="@string/text_created_profiles" />

        <View
            style="@style/View.Divider"
            android:layout_marginTop="1dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view"
            style="@style/View.Recycler"
            android:layout_width="match_parent"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:itemCount="10"
            tools:listitem="@layout/item_profile_more"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</layout>