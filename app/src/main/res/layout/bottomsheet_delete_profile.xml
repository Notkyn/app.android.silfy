<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".ui.dialog.menu.ProfileDeleteBottomsheet">

    <data>

        <variable
            name="model"
            type="ua.notky.silfy.models.model.Profile" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        style="@style/Root.Dialog">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/describe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_top_dialog_describe"
            android:text="@{String.format(@string/text_profile_delete_question, model.email)}"
            android:textAlignment="center"
            android:textAppearance="@style/TextAppearance.Dialog.Title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="@string/text_profile_delete_question"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/button_no"
            style="@style/Button.Revers.Small"
            android:text="@string/button_no"
            android:layout_marginTop="@dimen/margin_horizontal_small_button"
            android:layout_marginEnd="@dimen/margin_horizontal_small_button"
            app:layout_constraintTop_toBottomOf="@id/describe"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/button_yes"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/button_yes"
            style="@style/Button.Main.Small"
            android:text="@string/button_yes"
            android:layout_marginTop="@dimen/margin_horizontal_small_button"
            android:layout_marginStart="@dimen/margin_horizontal_small_button"
            app:layout_constraintTop_toBottomOf="@id/describe"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/button_no"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>