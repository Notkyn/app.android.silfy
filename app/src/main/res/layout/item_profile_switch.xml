<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--  5c Profile row: avatar 44, name, "English → Українська", "Active" badge on the active profile  -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@drawable/ds_bg_profile_row"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <ua.notky.silfy.ui.view.avatar.AvatarView
            android:id="@+id/avatar"
            android:layout_width="@dimen/ds_tile"
            android:layout_height="@dimen/ds_tile" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/text_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Silfy.RowTitle"
                tools:text="Olena" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/text_language"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Silfy.Caption.Medium"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                tools:text="English → Українська" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/text_active"
            style="@style/Widget.Silfy.Badge.Active"
            android:text="@string/profile_active" />
    </LinearLayout>
</layout>
