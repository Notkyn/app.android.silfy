<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".ui.layout.menu.CountErrorsTrainingLayout">

    <data>

        <variable
            name="model"
            type="ua.notky.silfy.models.observable.TrainingSettingsModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/text_count_errors"
            android:layout_marginHorizontal="@dimen/margin_small_horizontal_text"
            android:textAppearance="@style/TextAppearance.Text.Label"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <View
            android:id="@+id/divider"
            style="@style/View.Divider"
            android:layout_marginTop="3dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/title"/>

        <androidx.appcompat.widget.AppCompatCheckBox
            android:id="@+id/checkbox_errors"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/text_limit_errors"
            android:checked="@={model.enableErrors}"
            android:layout_marginHorizontal="10dp"
            android:paddingHorizontal="10dp"
            android:layout_marginTop="8dp"
            android:textSize="14sp"
            android:textColor="@color/primary_dark_v2_color"
            android:button="@null"
            android:drawablePadding="10dp"
            android:drawableStart="@drawable/selector_checkbox"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/divider"
            app:layout_constraintEnd_toStartOf="@id/input"
            tools:checked="true"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/input"
            style="@style/TextInputLayout.NoHint"
            android:layout_width="80dp"
            android:layout_marginEnd="10dp"
            android:layout_marginStart="10dp"
            app:layout_constraintTop_toTopOf="@id/checkbox_errors"
            app:layout_constraintBottom_toBottomOf="@id/checkbox_errors"
            app:layout_constraintEnd_toEndOf="parent">

            <ua.notky.base.ui.view.edittext.ClearFocusEditText
                android:id="@+id/edit"
                style="@style/TextInputEditText"
                android:textSize="16sp"
                android:layout_height="30dp"
                android:paddingBottom="0dp"
                android:paddingTop="0dp"
                android:gravity="center"
                android:inputType="number"
                android:imeOptions="actionDone"
                android:maxLength="3"
                app:gone="@{model.enableErrors}"
                android:text="@={model.countErrors}"
                tools:text="34534"/>
        </com.google.android.material.textfield.TextInputLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>