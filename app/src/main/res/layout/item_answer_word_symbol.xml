<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".ui.adapter.AnswerWordSymbolAdapter">

    <data>

        <variable
            name="model"
            type="ua.notky.silfy.models.observable.SymbolModel" />
    </data>

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/button_symbol"
            style="@style/Button.Symbol"
            android:text="@{model.symbol}"
            app:setSelectSymbolState="@{model.isSelect}"
            tools:text="W"/>
    </FrameLayout>
</layout>