<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".ui.fragment.onboarding.CreateProfileFragment">

    <!--  1d Create profile: name + one of 7 languages. Button pinned to the bottom  -->
    <LinearLayout
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/screen_bg"
        android:orientation="vertical">

        <!--  Toolbar  -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/ds_toolbar_height"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_back"
                style="@style/Widget.Silfy.Button.Icon.Toolbar"
                android:layout_gravity="center_vertical"
                android:contentDescription="@string/action_back"
                app:icon="@drawable/ic_lc_arrow_left" />
        </FrameLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="@dimen/ds_form_padding"
            android:paddingTop="4dp"
            android:paddingEnd="@dimen/ds_form_padding"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/Widget.Silfy.Text.Headline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/create_title" />

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/Widget.Silfy.Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/create_subtitle" />

                <!--  Name  -->
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/label_name"
                    style="@style/Widget.Silfy.Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:labelFor="@id/edit_name"
                    android:text="@string/create_name_label" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/input_name"
                    style="@style/Widget.Silfy.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_label_gap">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edit_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/create_name_hint"
                        android:imeOptions="actionDone"
                        android:importantForAutofill="no"
                        android:inputType="textPersonName|textCapWords"
                        android:maxLength="30"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <!--  Language  -->
                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/Widget.Silfy.Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="@string/create_language_label" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Silfy.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_label_gap"
                    app:shapeAppearance="@style/ShapeAppearance.Silfy.Card.Small">

                    <LinearLayout
                        android:id="@+id/list_languages"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:divider="@drawable/ds_divider"
                        android:orientation="vertical"
                        android:showDividers="middle" />
                </com.google.android.material.card.MaterialCardView>

                <!--  "Can't be changed later"  -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_label_gap"
                    android:orientation="horizontal"
                    android:paddingStart="2dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="2dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginTop="1dp"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_lc_info"
                        app:tint="@color/text_secondary" />

                    <androidx.appcompat.widget.AppCompatTextView
                        style="@style/Widget.Silfy.Text.Caption"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/create_language_note" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!--  Bottom bar  -->
        <LinearLayout
            android:id="@+id/bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/ds_bottom_bar_padding_horizontal"
            android:paddingTop="@dimen/ds_bottom_bar_padding_top"
            android:paddingEnd="@dimen/ds_bottom_bar_padding_horizontal"
            android:paddingBottom="@dimen/ds_bottom_bar_padding_bottom">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_create"
                style="@style/Widget.Silfy.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:text="@string/create_button" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/text_privacy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Silfy.Caption.Small"
                tools:text="By continuing you accept the Privacy Policy" />
        </LinearLayout>
    </LinearLayout>
</layout>
