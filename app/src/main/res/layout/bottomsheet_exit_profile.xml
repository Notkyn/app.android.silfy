<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".ui.dialog.category.DeleteCategoryBottomsheet">

    <androidx.constraintlayout.widget.ConstraintLayout
        style="@style/Root.Dialog"
        android:paddingStart="@dimen/padding_dialog_horizontal_small"
        android:paddingEnd="@dimen/padding_dialog_horizontal_small">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/title"
            style="@style/View.Dialog.Title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:text="@string/text_exit" />

        <View
            android:id="@+id/divider"
            style="@style/View.Divider"
            android:layout_marginTop="@dimen/margin_top_dialog_divider"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/title"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/describe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_top_dialog_describe"
            android:text="@string/text_exit_question"
            android:textAlignment="center"
            android:textAppearance="@style/TextAppearance"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/button_no"
            style="@style/Button.Revers.Small"
            android:text="@string/button_no"
            android:layout_marginTop="@dimen/margin_top_small_button"
            android:layout_marginEnd="@dimen/margin_horizontal_small_button"
            app:layout_constraintTop_toBottomOf="@id/describe"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/button_yes"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/button_yes"
            style="@style/Button.Main.Small"
            android:text="@string/button_yes"
            android:layout_marginTop="@dimen/margin_top_small_button"
            android:layout_marginStart="@dimen/margin_horizontal_small_button"
            app:layout_constraintTop_toBottomOf="@id/describe"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/button_no"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>