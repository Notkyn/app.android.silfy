<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".ui.fragment.go.SessionFragment">

    <!--  4c–4h Session: ✕ + timer + mistakes, ink word card, answer area (Choose / Letters / Type),
          feedback banner and Check / Next pinned to the bottom (above the keyboard)  -->
    <LinearLayout
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/screen_bg"
        android:orientation="vertical"
        android:paddingTop="6dp">

        <!--  Top bar  -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/ds_screen_padding"
            android:paddingEnd="@dimen/ds_screen_padding">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_close"
                style="@style/Widget.Silfy.Button.Icon.Outlined"
                android:contentDescription="@string/session_end_button"
                app:icon="@drawable/ic_lc_x" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/text_timer"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/ds_bg_session_chip_ink"
                android:drawablePadding="6dp"
                android:fontFeatureSettings="tnum"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textAppearance="@style/TextAppearance.Silfy.Button.Dialog"
                android:textColor="@color/text_on_ink"
                app:drawableStartCompat="@drawable/ic_lc_timer_17"
                app:drawableTint="@color/aqua"
                tools:text="03:48" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/text_mistakes"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/ds_bg_session_chip"
                android:drawablePadding="6dp"
                android:fontFeatureSettings="tnum"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textAppearance="@style/TextAppearance.Silfy.Button.Dialog"
                android:textColor="@color/ink"
                app:drawableStartCompat="@drawable/ic_lc_heart_crack_17"
                app:drawableTint="@color/error_border"
                tools:text="1/5" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="@dimen/ds_screen_padding"
            android:paddingTop="16dp"
            android:paddingEnd="@dimen/ds_screen_padding"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!--  Word card  -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Silfy.Card.Ink"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="20dp"
                        android:paddingTop="22dp"
                        android:paddingEnd="20dp"
                        android:paddingBottom="24dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/text_number"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:includeFontPadding="false"
                                android:textAppearance="@style/TextAppearance.Silfy.Caption.Medium"
                                android:textColor="@color/text_on_ink_3"
                                tools:text="Word 15" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/text_direction"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/ds_bg_direction_badge"
                                android:fontFamily="@font/onest_bold"
                                android:includeFontPadding="false"
                                android:paddingStart="8dp"
                                android:paddingTop="4dp"
                                android:paddingEnd="8dp"
                                android:paddingBottom="4dp"
                                android:textColor="@color/aqua"
                                android:textSize="11sp"
                                tools:text="EN → UA" />
                        </LinearLayout>

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/text_prompt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:lineSpacingMultiplier="1.05"
                            android:maxLines="3"
                            android:paddingTop="14dp"
                            android:paddingBottom="6dp"
                            android:textAppearance="@style/TextAppearance.Silfy.Display.Word"
                            app:autoSizeMaxTextSize="38sp"
                            app:autoSizeMinTextSize="20sp"
                            app:autoSizeTextType="uniform"
                            tools:text="apple" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/text_caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:fontFamily="@font/onest_medium"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:textColor="@color/text_on_ink_2"
                            android:textSize="14sp"
                            tools:text="@string/session_caption_choose" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!--  Choose: 2 × 2 options  -->
                <LinearLayout
                    android:id="@+id/view_choose"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/option_1"
                            style="@style/Widget.Silfy.Button.Option"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            tools:text="хліб" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/option_2"
                            style="@style/Widget.Silfy.Button.Option"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/ds_card_gap"
                            android:layout_weight="1"
                            tools:text="яблуко" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/row_options_2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_card_gap"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/option_3"
                            style="@style/Widget.Silfy.Button.Option"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            tools:text="сир" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/option_4"
                            style="@style/Widget.Silfy.Button.Option"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/ds_card_gap"
                            android:layout_weight="1"
                            tools:text="сад" />
                    </LinearLayout>
                </LinearLayout>

                <!--  Letters: slots, tiles + erase  -->
                <LinearLayout
                    android:id="@+id/view_letters"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.flexbox.FlexboxLayout
                        android:id="@+id/flex_slots"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="52dp"
                        app:flexWrap="wrap"
                        app:justifyContent="center" />

                    <com.google.android.flexbox.FlexboxLayout
                        android:id="@+id/flex_tiles"
                        android:layout_width="300dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        app:flexWrap="wrap"
                        app:justifyContent="center" />
                </LinearLayout>

                <!--  Type  -->
                <LinearLayout
                    android:id="@+id/view_type"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/edit_answer"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:fontFamily="@font/onest_semibold"
                        android:gravity="center"
                        android:hint="@string/session_type_hint"
                        android:imeOptions="actionDone"
                        android:importantForAutofill="no"
                        android:inputType="textNoSuggestions|textVisiblePassword"
                        android:maxLength="50"
                        android:maxLines="1"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:textColor="@color/ink"
                        android:textColorHint="@color/text_placeholder"
                        android:textSize="22sp" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/text_correct_answer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/onest_medium"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:visibility="gone"
                        tools:text="Correct answer: journey"
                        tools:visibility="visible" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!--  Feedback + Check / Next  -->
        <LinearLayout
            android:id="@+id/bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/ds_screen_padding"
            android:paddingEnd="@dimen/ds_screen_padding"
            android:paddingBottom="@dimen/ds_bottom_bar_padding_bottom">

            <LinearLayout
                android:id="@+id/view_feedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/ds_bg_feedback"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp"
                android:paddingBottom="12dp"
                android:visibility="gone"
                tools:backgroundTint="@color/success_bg"
                tools:visibility="visible">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/icon_feedback"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    tools:srcCompat="@drawable/ic_lc_circle_check" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/text_feedback"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:accessibilityLiveRegion="polite"
                    android:includeFontPadding="false"
                    android:textAppearance="@style/TextAppearance.Silfy.RowTitle"
                    android:textSize="14sp"
                    tools:text="Correct! Level up for “apple”"
                    tools:textColor="@color/success_text" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_main"
                style="@style/Widget.Silfy.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="@string/session_next" />
        </LinearLayout>
    </LinearLayout>
</layout>
