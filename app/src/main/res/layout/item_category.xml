<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="model"
            type="ua.notky.silfy.models.model.Category" />
    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:paddingEnd="22dp"
            android:paddingStart="30dp"
            android:layout_gravity="center"
            android:background="@drawable/selector_bg_button_category"
            android:elevation="@dimen/elevation_button"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:ellipsize="end"
                android:maxLines="1"
                android:gravity="center_vertical"
                android:textAppearance="@style/TextAppearance.Text"
                android:text="@{model.title}"
                tools:text="Category name name sad asd asdas dasd "/>

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:layout_marginHorizontal="20dp"
                android:textAppearance="@style/TextAppearance.Text.Sub"
                app:setCountWords="@{model.words.size()}"
                tools:text="32 words"/>

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginVertical="10dp"
                android:background="@drawable/ic_arrow_back"
                android:backgroundTint="@color/black"
                android:rotation="180"/>
        </androidx.appcompat.widget.LinearLayoutCompat>

    </FrameLayout>
</layout>