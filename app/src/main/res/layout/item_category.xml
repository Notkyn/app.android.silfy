<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--  3a Category card in the 2-column grid: letter tile 44, name, "{n} words".
          Gaps between cards — GridSpacingItemDecoration  -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Silfy.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/text_initial"
                android:layout_width="@dimen/ds_tile"
                android:layout_height="@dimen/ds_tile"
                android:background="@drawable/ds_bg_tile"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:textAppearance="@style/TextAppearance.Silfy.Initial"
                android:textSize="18sp"
                tools:backgroundTint="@color/avatar_1"
                tools:text="S" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/text_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Silfy.RowTitle.Large"
                tools:text="Sport" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/text_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Silfy.Caption"
                tools:text="3 words" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>
