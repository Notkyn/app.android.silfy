<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".ui.fragment.go.SessionResultsFragment">

    <!--  4j Results: ink card (reason, "Nice work", accuracy ring), 2 × 2 stats, Another session / Back to dictionary  -->
    <LinearLayout
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/screen_bg"
        android:orientation="vertical">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="@dimen/ds_screen_padding"
            android:paddingTop="18dp"
            android:paddingEnd="@dimen/ds_screen_padding"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Silfy.Card.Ink"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:shapeAppearance="@style/ShapeAppearance.Silfy.Card.Results">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingStart="20dp"
                        android:paddingTop="24dp"
                        android:paddingEnd="20dp"
                        android:paddingBottom="26dp">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/text_reason"
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:background="@drawable/ds_bg_reason_badge"
                            android:drawablePadding="6dp"
                            android:gravity="center_vertical"
                            android:includeFontPadding="false"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:textAppearance="@style/TextAppearance.Silfy.RowTitle"
                            android:textColor="@color/aqua"
                            android:textSize="13sp"
                            app:drawableTint="@color/aqua"
                            tools:drawableStart="@drawable/ic_lc_timer_15"
                            tools:text="@string/results_time" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/text_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:lineSpacingMultiplier="1.2"
                            android:textAppearance="@style/TextAppearance.Silfy.Headline.Small"
                            android:textColor="@color/text_on_ink"
                            tools:text="Nice work, Olena!" />

                        <FrameLayout
                            android:layout_width="164dp"
                            android:layout_height="164dp"
                            android:layout_marginTop="18dp">

                            <ua.notky.silfy.ui.view.ring.AccuracyRingView
                                android:id="@+id/ring_accuracy"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:gravity="center_horizontal"
                                android:orientation="vertical">

                                <androidx.appcompat.widget.AppCompatTextView
                                    android:id="@+id/text_accuracy"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:includeFontPadding="false"
                                    android:textAppearance="@style/TextAppearance.Silfy.Display.Word"
                                    tools:text="79%" />

                                <androidx.appcompat.widget.AppCompatTextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:includeFontPadding="false"
                                    android:text="@string/results_accuracy"
                                    android:textAppearance="@style/TextAppearance.Silfy.Caption.Medium"
                                    android:textColor="@color/text_on_ink_3" />
                            </LinearLayout>
                        </FrameLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!--  Stats 2 × 2  -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/stat_selected"
                        layout="@layout/item_session_stat"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/stat_used"
                        layout="@layout/item_session_stat"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ds_card_gap"
                        android:layout_weight="1" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_card_gap"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/stat_correct"
                        layout="@layout/item_session_stat"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/stat_wrong"
                        layout="@layout/item_session_stat"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ds_card_gap"
                        android:layout_weight="1" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:id="@+id/bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/ds_screen_padding"
            android:paddingEnd="@dimen/ds_screen_padding"
            android:paddingBottom="@dimen/ds_bottom_bar_padding_bottom">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_again"
                style="@style/Widget.Silfy.Button.Accent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/results_again"
                app:icon="@drawable/ic_lc_rotate_ccw"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconSize="@dimen/ds_icon_small" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_back"
                style="@style/Widget.Silfy.Button.Ghost"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:minHeight="52dp"
                android:text="@string/results_back"
                android:textAppearance="@style/TextAppearance.Silfy.Button.Dialog" />
        </LinearLayout>
    </LinearLayout>
</layout>
