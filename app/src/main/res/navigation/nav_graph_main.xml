<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph_main"
    app:startDestination="@id/fragment_words">

    <activity
        android:id="@+id/activity_main"
        android:name="ua.notky.silfy.ui.activity.MainActivity"
        android:label="activityMain"
        tools:layout="@layout/activity_main" />

    <activity
        android:id="@+id/activity_go"
        android:name="ua.notky.silfy.ui.activity.GoActivity"
        android:label="activityGo"
        tools:layout="@layout/activity_go"/>

    <activity
        android:id="@+id/activity_auth"
        android:name="ua.notky.silfy.ui.activity.AuthActivity"
        android:label="activityAuth"
        tools:layout="@layout/activity_auth"/>

    <action
        android:id="@+id/to_activity_go"
        app:destination="@id/activity_go"
        app:enterAnim="@anim/slide_in_top"
        app:exitAnim="@android:anim/fade_out"/>

    <action
        android:id="@+id/to_activity_auth"
        app:destination="@id/activity_auth"
        app:enterAnim="@anim/slide_activity_in_right"
        app:exitAnim="@anim/slide_activity_out_right"/>

    <action
        android:id="@+id/action_global_to_fragmentWords"
        app:destination="@id/fragment_words"
        app:enterAnim="@android:anim/fade_in"
        app:exitAnim="@anim/nav_fast_fade_out"
        app:popEnterAnim="@android:anim/fade_in"
        app:popExitAnim="@anim/nav_fast_fade_out"
        app:launchSingleTop="true"
        app:popUpTo="@id/fragment_words"
        app:popUpToInclusive="false"/>

    <action
        android:id="@+id/action_global_to_fragmentCategory"
        app:destination="@id/fragment_category"
        app:enterAnim="@android:anim/fade_in"
        app:exitAnim="@anim/nav_fast_fade_out"
        app:popEnterAnim="@android:anim/fade_in"
        app:popExitAnim="@anim/nav_fast_fade_out"
        app:launchSingleTop="true"
        app:popUpTo="@id/fragment_words"
        app:popUpToInclusive="false"/>

    <action
        android:id="@+id/action_global_to_fragmentProfile"
        app:destination="@id/fragment_profile"
        app:enterAnim="@android:anim/fade_in"
        app:exitAnim="@anim/nav_fast_fade_out"
        app:popEnterAnim="@android:anim/fade_in"
        app:popExitAnim="@anim/nav_fast_fade_out"
        app:launchSingleTop="true"
        app:popUpTo="@id/fragment_words"
        app:popUpToInclusive="false"/>

    <action
        android:id="@+id/action_global_to_fragmentMenu"
        app:destination="@id/fragment_menu"
        app:enterAnim="@android:anim/fade_in"
        app:exitAnim="@anim/nav_fast_fade_out"
        app:popEnterAnim="@android:anim/fade_in"
        app:popExitAnim="@anim/nav_fast_fade_out"
        app:launchSingleTop="true"
        app:popUpTo="@id/fragment_words"
        app:popUpToInclusive="false"/>

    <fragment
        android:id="@+id/fragment_words"
        android:name="ua.notky.silfy.ui.fragment.words.WordsFragment"
        android:label="fragmentWords"
        tools:layout="@layout/fragment_words">

        <action
            android:id="@+id/action_fragmentWords_to_fragmentWordsEdit"
            app:destination="@+id/fragment_words_edit"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>

    <fragment
        android:id="@+id/fragment_words_edit"
        android:name="ua.notky.silfy.ui.fragment.words.WordsEditFragment"
        android:label="fragmentWordsEdit"
        tools:layout="@layout/fragment_words_edit">

        <!--  -1 — new word  -->
        <argument
            android:name="wordId"
            android:defaultValue="-1"
            app:argType="integer" />

        <!--  New word only: the category it starts in ("Add word" on 3b), -1 — none  -->
        <argument
            android:name="categoryId"
            android:defaultValue="-1"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/fragment_category"
        android:name="ua.notky.silfy.ui.fragment.category.CategoryFragment"
        android:label="fragmentCategory"
        tools:layout="@layout/fragment_category">

        <action
            android:id="@+id/action_fragmentCategory_to_fragmentCategoryOverview"
            app:destination="@+id/fragment_category_overview"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>

    <fragment
        android:id="@+id/fragment_category_overview"
        android:name="ua.notky.silfy.ui.fragment.category.CategoryOverviewFragment"
        android:label="fragmentCategoryOverview"
        tools:layout="@layout/fragment_category_overview">

        <argument
            android:name="categoryId"
            app:argType="integer" />

        <action android:id="@+id/action_fragmentCategoryOverview_to_fragmentWordsEdit"
            app:destination="@id/fragment_words_edit"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>

    <fragment
        android:id="@+id/fragment_profile"
        android:name="ua.notky.silfy.ui.fragment.profile.ProfileFragment"
        android:label="fragmentProfile"
        tools:layout="@layout/fragment_profile"/>

    <!--  6a Menu  -->
    <fragment
        android:id="@+id/fragment_menu"
        android:name="ua.notky.silfy.ui.fragment.menu.MenuFragment"
        android:label="fragmentMenu"
        tools:layout="@layout/fragment_menu">

        <action
            android:id="@+id/action_fragmentMenu_to_fragmentTrainingSettingsMenu"
            app:destination="@id/fragment_menu_training_settings"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>

        <action
            android:id="@+id/action_fragmentMenu_to_fragmentDictionaryMenu"
            app:destination="@id/fragment_menu_dictionary"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>

        <action
            android:id="@+id/action_fragmentMenu_to_fragmentGoodToKnow"
            app:destination="@id/fragment_menu_good_to_know"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>

    <!--  6b Training mode: the session settings screen with "Save settings"  -->
    <fragment
        android:id="@+id/fragment_menu_training_settings"
        android:name="ua.notky.silfy.ui.fragment.go.SessionSetupFragment"
        android:label="fragmentTrainingSettings"
        tools:layout="@layout/fragment_session_setup">

        <argument
            android:name="isMenu"
            android:defaultValue="true"
            app:argType="boolean" />
    </fragment>

    <!--  6c Dictionary: reset progress / default set / clear lists  -->
    <fragment
        android:id="@+id/fragment_menu_dictionary"
        android:name="ua.notky.silfy.ui.fragment.menu.DictionarySettingsFragment"
        android:label="fragmentMenuDictionary"
        tools:layout="@layout/fragment_dictionary_settings"/>

    <!--  6e–6g Good to know from the menu  -->
    <fragment
        android:id="@+id/fragment_menu_good_to_know"
        android:name="ua.notky.silfy.ui.fragment.goodtoknow.GoodToKnowFragment"
        android:label="fragmentMenuGoodToKnow"
        tools:layout="@layout/fragment_good_to_know">
        <argument
            android:name="languageCode"
            app:argType="string" />
        <argument
            android:name="onboarding"
            android:defaultValue="false"
            app:argType="boolean" />
    </fragment>

</navigation>